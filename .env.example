# --- Toast Standard API access (READ-ONLY) ---------------------------------
# Create these in Toast Web: Integrations > Toast API access > Manage credentials.
# Needs RMS Essentials or higher and the "Manage Integrations" permission.
# Scopes to tick: menus:read, stock:read, restaurants:read
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
# The location GUID (a.k.a. Toast-Restaurant-External-ID), shown on the credentials page.
TOAST_RESTAURANT_GUID=
# Production host. Sandbox credentials use https://ws-sandbox-api.eng.toasttab.com
TOAST_API_HOST=https://ws-api.toasttab.com

# --- Checkout hand-off -----------------------------------------------------
# Your public Toast online ordering page. Every "Add to order" deep-links into it.
NEXT_PUBLIC_TOAST_ORDER_URL=https://www.toasttab.com/local/order/bomberry-1223-n-grand-ave

# --- Optional ------------------------------------------------------------
# Secret for POST /api/revalidate (refresh the menu instantly after a change in Toast).
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=https://bomberry.example
